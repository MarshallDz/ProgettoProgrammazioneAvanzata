    {
      "name": "Create Grid",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Genera dimensioni casuali tra 1 e 10\r\nconst rows = Math.floor(Math.random() * 10) + 1;\r\nconst cols = Math.floor(Math.random() * 10) + 1;\r\n\r\n// 2. Crea la matrice 2D con valori binari (0 o 1)\r\nlet matrix = [];\r\nfor (let i = 0; i < rows; i++) {\r\n    let row = [];\r\n    for (let j = 0; j < cols; j++) {\r\n        // Genera 0 o 1 casualmente\r\n        row.push(Math.round(Math.random()));\r\n    }\r\n    matrix.push(row);\r\n}\r\n\r\n// 3. Salva la matrice come stringa JSON nella variabile di collezione\r\npm.collectionVariables.set(\"random_matrix\", JSON.stringify(matrix));\r\n"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\r\n\r\npm.collectionVariables.set(\"lastModelIdCreated\", jsonData.data.id);\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT_TOKEN_USER}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"matrice_{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}\",\r\n    \"matrix\": {{random_matrix}}\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URI}}:{{PORT}}/api/v1/grids",
          "host": [
            "{{BASE_URI}}"
          ],
          "port": "{{PORT}}",
          "path": [
            "api",
            "v1",
            "grids"
          ]
        }
      },
      "response": []
    },
