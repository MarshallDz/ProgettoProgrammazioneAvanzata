    {
      "name": "Update Grid",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Recupera la matrice salvata nella variabile di collezione\r\nconst matrixString = pm.collectionVariables.get(\"random_matrix\");\r\n\r\nif (!matrixString) {\r\n    console.log(\"Nessuna matrice trovata in 'random_matrix'. Esegui prima la generazione.\");\r\n} else {\r\n    // Converte la stringa JSON di nuovo in un array 2D\r\n    let matrix = JSON.parse(matrixString);\r\n    \r\n    const cols = matrix.length;\r\n    const rows = matrix[0].length;\r\n    \r\n    // 2. Modifica i valori delle celle \r\n    for (let i = 0; i < rows; i++) {\r\n        for (let j = 0; j < cols; j++) {          \r\n            // Rigenera un valore binario casuale per ogni cella\r\n            matrix[i][j] = Math.round(Math.random());\r\n        }\r\n    }\r\n    \r\n    // 3. Salva nuovamente la matrice aggiornata nella variabile di collezione\r\n    pm.collectionVariables.set(\"new_random_matrix\", JSON.stringify(matrix));    \r\n}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {\r\n    const jsonData = pm.response.json();\r\n    pm.collectionVariables.set(\"lastUpdateRequestIdCreated\", jsonData.data.id);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT_TOKEN_USER}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"matrix\": {{new_random_matrix}}\r\n}",
