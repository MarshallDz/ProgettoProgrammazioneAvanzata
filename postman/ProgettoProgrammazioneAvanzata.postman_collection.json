    {
      "name": "Run a model",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Recupera la matrice dalle collection variables\r\nconst matrixString = pm.collectionVariables.get(\"random_matrix\");\r\n\r\nif (!matrixString) {\r\n    console.log(\"Nessuna matrice trovata in 'random_matrix'.\");\r\n} else {\r\n    const matrix = JSON.parse(matrixString);\r\n\r\n    // 2. Funzione per generare punti casuali validi (valore 0, o 1 a seconda delle tue regole)\r\n    function getRandomValidPoint(matrix) {\r\n        const r = matrix.length;\r\n        const c = matrix[0].length;\r\n        \r\n        let x, y;\r\n        let attempts = 0;\r\n        const maxAttempts = r * c * 2;\r\n        \r\n        // Cerca una cella che sia \"attraversabile\" (es. valore 0) \r\n        // oppure rimuovi il controllo se va bene qualsiasi coordinata casuale.\r\n        do {\r\n            x = Math.floor(Math.random() * r);\r\n            y = Math.floor(Math.random() * c);\r\n            attempts++;\r\n            // Supponiamo che il punto sia valido se la cella è 0 (libera)\r\n            if (matrix[x][y] === 0 || attempts > maxAttempts) {\r\n                break;\r\n            }\r\n        } while (true);\r\n        \r\n        return { x: x, y: y };\r\n    }\r\n\r\n    // 3. Genera goal\r\n    const goal = getRandomValidPoint(matrix);\r\n\r\n    // Salva i punti nelle collection variables per poterli riusare nelle chiamate successive\r\n    pm.collectionVariables.set(\"goal_x\", goal.x);\r\n    pm.collectionVariables.set(\"goal_y\", goal.y);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{JWT_TOKEN_USER}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"start\": {\r\n        \"x\": {{start_x}},\r\n        \"y\": {{start_y}}\r\n    },\r\n    \"goal\": {\r\n        \"x\": {{goal_x}},\r\n        \"y\": {{goal_y}}\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URI}}:{{PORT}}/api/v1/grids/{{lastModelIdCreated}}/run",
          "host": [
            "{{BASE_URI}}"
          ],
          "port": "{{PORT}}",
          "path": [
            "api",
            "v1",
            "grids",
            "{{lastModelIdCreated}}",
            "run"
          ]
        }
      },
      "response": []
